  Port of lineage-23.2 shared/ui/composable/StackedMobileIcon.kt:91 layout
  Row [ RAT type ] [ stacked bars ] [ roaming ] + [in/out] — additive, original
  status_bar_mobile_signal_group.xml is left untouched.

  Composition mirrors StackedMobileIcon.kt:
    Row [ ActivityIndicators? ] [ RAT Image 12sp ] [ Canvas 16/18.5sp×12sp ] [ Roaming 10sp ]
-->
<com.android.systemui.statusbar.stacked.StackedMobileView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stacked_combo"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:gravity="center_vertical">

    <com.android.keyguard.AlphaOptimizedLinearLayout
        android:id="@+id/stacked_group"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/stacked_inout_container"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_gravity="center_vertical">
            <ImageView
                android:id="@+id/stacked_in"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_activity_down"
                android:visibility="gone"
                android:paddingEnd="2dp" />
            <ImageView
                android:id="@+id/stacked_out"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_activity_up"
                android:paddingEnd="2dp"
                android:visibility="gone" />
        </FrameLayout>

        <ImageView
            android:id="@+id/stacked_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingStart="2.5dp"
            android:paddingEnd="1dp"
            android:visibility="gone" />

        <Space
            android:id="@+id/stacked_roaming_space"
            android:layout_width="@dimen/roaming_icon_start_padding"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical">
            <ImageView
                android:id="@+id/stacked_bars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/stacked_roaming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/stat_sys_roaming"
                android:contentDescription="@string/data_connection_roaming"
                android:visibility="gone" />
        </FrameLayout>
    </com.android.keyguard.AlphaOptimizedLinearLayout>
</com.android.systemui.statusbar.stacked.StackedMobileView>
